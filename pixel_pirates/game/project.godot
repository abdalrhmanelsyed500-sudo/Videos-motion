; Engine configuration file - Crown of the Seas (working title). Godot 4.7.x, COMPATIBILITY renderer (A1-2).
; Edit by hand only if you know what you do; the editor rewrites this file in its own order.
config_version=5

[application]

config/name="Crown of the Seas"
config/description="Open-world pirate survival adventure (working title)."
run/main_scene="res://h2d/h2d0.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/version="0.0.1"

[autoload]

Log="*res://core/log.gd"
Bus="*res://core/bus.gd"
Quality="*res://core/quality.gd"
Assets="*res://core/assets.gd"
Data="*res://core/registry.gd"
DebugConsole="*res://ui/debug_console.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[shader_globals]

h2d_sun_dir={
"type": "vec3",
"value": Vector3(0.3, 0.8, -0.5)
}
h2d_sun_col={
"type": "vec3",
"value": Vector3(0.6, 0.55, 0.45)
}
h2d_amb_col={
"type": "vec3",
"value": Vector3(0.3, 0.35, 0.4)
}
h2d_fog_col={
"type": "vec3",
"value": Vector3(0.55, 0.64, 0.64)
}
h2d_fog_density={
"type": "float",
"value": 0.002
}
h2d_gamma={
"type": "float",
"value": 2.2
}
h2d_exposure={
"type": "float",
"value": 1.25
}
h2d_time={
"type": "float",
"value": 0.0
}
h2d_wind_to={
"type": "vec2",
"value": Vector2(0, 1)
}
h2d_cloud={
"type": "float",
"value": 0.2
}
h2d_storm={
"type": "float",
"value": 0.0
}
h2d_rain={
"type": "float",
"value": 0.0
}
h2d_adv={
"type": "vec2",
"value": Vector2(0, 0)
}
h2d_wind_ms={
"type": "float",
"value": 0.0
}
h2d_gust={
"type": "float",
"value": 0.0
}
h2d_sea={
"type": "float",
"value": 0.0
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
gl_compatibility/fallback_to_angle=true
textures/canvas_textures/default_texture_filter=0
