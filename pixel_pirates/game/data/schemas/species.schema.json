{
 "kind": "species",
 "key_field": "id",
 "id_prefix": "spc",
 "record": {
  "type": "object",
  "required": [
   "id",
   "name",
   "group",
   "habitat",
   "regions",
   "temp_c",
   "depth_m",
   "group_size",
   "activity",
   "speed_kn",
   "diet",
   "rarity",
   "methods",
   "lod",
   "value",
   "provisional",
   "owner",
   "source"
  ],
  "props": {
   "id": {
    "type": "string",
    "pattern": "^spc_[a-z0-9]+(_[a-z0-9]+)*$"
   },
   "name": {
    "type": "string",
    "pattern": "^.{2,40}$"
   },
   "scientific": {
    "type": "string",
    "pattern": "^[A-Z][a-z]+ [a-z]+( [a-z]+)?$"
   },
   "real": {
    "type": "boolean"
   },
   "group": {
    "type": "string",
    "enum": [
     "reef_fish",
     "pelagic_fish",
     "deep_fish",
     "cold_fish",
     "shark_ray",
     "cetacean",
     "pinniped",
     "reptile",
     "cephalopod",
     "crustacean",
     "cnidarian",
     "invertebrate",
     "plankton",
     "seabird",
     "strange"
    ]
   },
   "habitat": {
    "type": "string",
    "enum": [
     "reef",
     "coastal",
     "open_water",
     "deep",
     "polar",
     "kelp",
     "ice_edge",
     "seamount",
     "vent",
     "surface"
    ]
   },
   "regions": {
    "type": "array",
    "min_items": 1,
    "items": {
     "type": "object",
     "required": [
      "region",
      "abundance"
     ],
     "props": {
      "region": {
       "type": "string",
       "ref": "region"
      },
      "abundance": {
       "type": "number",
       "min": 0.05,
       "max": 1
      }
     }
    }
   },
   "temp_c": {
    "type": "array",
    "min_items": 2,
    "max_items": 2,
    "items": {
     "type": "number",
     "min": -3,
     "max": 36
    }
   },
   "depth_m": {
    "type": "array",
    "min_items": 2,
    "max_items": 2,
    "items": {
     "type": "number",
     "min": 0,
     "max": 11000
    }
   },
   "group_size": {
    "type": "array",
    "min_items": 2,
    "max_items": 2,
    "items": {
     "type": "integer",
     "min": 1,
     "max": 100000
    }
   },
   "season": {
    "type": "array",
    "min_items": 2,
    "max_items": 2,
    "items": {
     "type": "number",
     "min": 0,
     "max": 1
    }
   },
   "activity": {
    "type": "string",
    "enum": [
     "diurnal",
     "nocturnal",
     "crepuscular",
     "always"
    ]
   },
   "speed_kn": {
    "type": "number",
    "min": 0,
    "max": 40
   },
   "diet": {
    "type": "array",
    "items": {
     "type": "string",
     "pattern": "^[a-z_]+$"
    }
   },
   "needs_productivity": {
    "type": "number",
    "min": 0,
    "max": 1
   },
   "rarity": {
    "type": "string",
    "enum": [
     "common",
     "uncommon",
     "rare",
     "legendary"
    ]
   },
   "methods": {
    "type": "array",
    "min_items": 1,
    "items": {
     "type": "string",
     "enum": [
      "observe",
      "line",
      "net",
      "trap",
      "harpoon",
      "dredge",
      "dive",
      "report"
     ]
    },
    "unique_items": true
   },
   "needs": {
    "type": "array",
    "items": {
     "type": "string",
     "pattern": "^[a-z_]+$"
    },
    "unique_items": true
   },
   "danger": {
    "type": "number",
    "min": 0,
    "max": 1
   },
   "lod": {
    "type": "string",
    "enum": [
     "ambient",
     "school",
     "instance",
     "bespoke"
    ]
   },
   "value": {
    "type": "integer",
    "min": 0,
    "max": 5000
   },
   "sensitivity": {
    "type": "number",
    "min": 0,
    "max": 1
   },
   "asset": {
    "type": "string",
    "pattern": "^spr_[a-z0-9_]+$"
   },
   "note": {
    "type": "string",
    "pattern": "^.{1,300}$"
   },
   "provisional": {
    "type": "boolean"
   },
   "owner": {
    "type": "string",
    "pattern": "^[A-Z][0-9]{1,2}$"
   },
   "source": {
    "type": "string",
    "pattern": "^.{1,200}$"
   }
  }
 }
}