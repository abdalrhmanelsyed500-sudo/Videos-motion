{
 "kind": "island_template",
 "key_field": "id",
 "id_prefix": "tpl",
 "record": {
  "type": "object",
  "required": [
   "id",
   "name",
   "description",
   "tiers",
   "shape",
   "land_fraction",
   "relief",
   "coast",
   "landings",
   "slots"
  ],
  "props": {
   "id": {
    "type": "string",
    "pattern": "^tpl_[a-z0-9]+(_[a-z0-9]+)*$"
   },
   "name": {
    "type": "string",
    "pattern": "^.{2,40}$"
   },
   "description": {
    "type": "string",
    "pattern": "^.{1,300}$"
   },
   "tiers": {
    "type": "array",
    "min_items": 1,
    "unique_items": true,
    "items": {
     "type": "integer",
     "min": 1,
     "max": 3
    }
   },
   "multi_island": {
    "type": "boolean"
   },
   "shape": {
    "type": "object",
    "required": [
     "op"
    ],
    "props": {
     "op": {
      "type": "string",
      "enum": [
       "blob",
       "ring",
       "crescent",
       "ridge",
       "twin_lobes",
       "cone",
       "mesa",
       "stack_field",
       "flats",
       "fjord"
      ]
     },
     "params": {
      "type": "object",
      "values": {
       "type": "number"
      }
     }
    }
   },
   "land_fraction": {
    "type": "object",
    "required": [
     "min",
     "max"
    ],
    "props": {
     "min": {
      "type": "number",
      "min": 0.01,
      "max": 0.9
     },
     "max": {
      "type": "number",
      "min": 0.01,
      "max": 0.9
     }
    }
   },
   "relief": {
    "type": "object",
    "required": [
     "levels",
     "cliff_step",
     "rock_amount"
    ],
    "props": {
     "levels": {
      "type": "integer",
      "min": 1,
      "max": 15
     },
     "cliff_step": {
      "type": "integer",
      "min": 1,
      "max": 6
     },
     "rock_amount": {
      "type": "number",
      "min": 0,
      "max": 1
     }
    }
   },
   "coast": {
    "type": "object",
    "required": [
     "shallow_tiles",
     "beach_tiles"
    ],
    "props": {
     "shallow_tiles": {
      "type": "number",
      "min": 1,
      "max": 30
     },
     "beach_tiles": {
      "type": "number",
      "min": 1,
      "max": 8
     }
    }
   },
   "landings": {
    "type": "array",
    "items": {
     "type": "integer",
     "min": 1,
     "max": 4
    },
    "min_items": 2,
    "max_items": 2
   },
   "slots": {
    "type": "array",
    "min_items": 1,
    "items": {
     "type": "object",
     "required": [
      "id",
      "kind",
      "count"
     ],
     "props": {
      "id": {
       "type": "string",
       "pattern": "^[a-z][a-z0-9_]*$"
      },
      "kind": {
       "type": "string",
       "enum": [
        "survival",
        "hook",
        "secret",
        "story",
        "camp"
       ]
      },
      "count": {
       "type": "object",
       "required": [
        "1",
        "2",
        "3"
       ],
       "props": {
        "1": {
         "type": "array",
         "items": {
          "type": "integer",
          "min": 0,
          "max": 40
         },
         "min_items": 2,
         "max_items": 2
        },
        "2": {
         "type": "array",
         "items": {
          "type": "integer",
          "min": 0,
          "max": 40
         },
         "min_items": 2,
         "max_items": 2
        },
        "3": {
         "type": "array",
         "items": {
          "type": "integer",
          "min": 0,
          "max": 40
         },
         "min_items": 2,
         "max_items": 2
        }
       }
      },
      "where": {
       "type": "object",
       "props": {
        "terrain": {
         "type": "array",
         "min_items": 1,
         "unique_items": true,
         "items": {
          "type": "string",
          "enum": [
           "beach",
           "ground",
           "upland",
           "rock"
          ]
         }
        },
        "coast_tiles": {
         "type": "array",
         "items": {
          "type": "number",
          "min": 0,
          "max": 200
         },
         "min_items": 2,
         "max_items": 2
        },
        "near_slot": {
         "type": "string",
         "pattern": "^[a-z][a-z0-9_]*$"
        },
        "near_tiles": {
         "type": "array",
         "items": {
          "type": "number",
          "min": 0,
          "max": 400
         },
         "min_items": 2,
         "max_items": 2
        }
       }
      },
      "spacing_tiles": {
       "type": "integer",
       "min": 2,
       "max": 60
      }
     }
    }
   },
   "provisional": {
    "type": "boolean"
   },
   "owner": {
    "type": "string",
    "pattern": "^[A-Z][0-9]{1,2}$"
   },
   "source": {
    "type": "string",
    "pattern": "^.{1,200}$"
   }
  }
 }
}
