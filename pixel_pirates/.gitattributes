# Line endings: LF everywhere in the repo (Windows git converts on checkout if configured).
* text=auto eol=lf
*.png binary
*.jpg binary
*.ogg binary
*.wav binary
*.zip binary
# Git LFS is NOT enabled yet (decision gate A2-7: first single binary > 5 MB, or repo > 500 MB).
# When enabled, uncomment, run `git lfs install` and `git lfs migrate import --include=...`:
#   *.psd  filter=lfs diff=lfs merge=lfs -text
#   *.aseprite filter=lfs diff=lfs merge=lfs -text
#   *.blend filter=lfs diff=lfs merge=lfs -text
#   *.wav  filter=lfs diff=lfs merge=lfs -text
