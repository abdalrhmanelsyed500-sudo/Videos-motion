; EGYPTIAN TUKTUK MAYHEM - Godot 4.7.2 project (Compatibility renderer: desktop GL + web/wasm harness)
config_version=5

[application]

config/name="Egyptian Tuktuk Mayhem"
config/description="Arcade passenger-delivery driving in an original contemporary Egyptian city. Phase 1 playable core."
run/main_scene="res://scenes/boot/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/textures/t_sign_band.png"

[autoload]

Reg="*res://scripts/core/reg.gd"
Tk="*res://scripts/core/tk.gd"
MissionMgr="*res://scripts/core/mission_mgr.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

