extends RefCounted
## Used via preload constant (raw wasm runtime has no editor class cache): MeshBuilder
## Builds ArrayMeshes from the authored runtime specs in res://data/meshes/*.mesh.json
## (generated by tools/make_models.py, which also exports .obj/.mtl as DCC source).
## The Godot RUNTIME (web template and exported builds) cannot import .obj without the editor,
## so gameplay geometry is built here - identical numbers, deterministic, import-free.

static func build(spec_name: String) -> ArrayMesh:
	var spec: Dictionary = Reg.mesh_spec(spec_name)
	var mesh := ArrayMesh.new()
	var groups: Dictionary = spec.get("groups", {})
	for gname in groups.keys():
		var g: Dictionary = groups[gname]
		var verts: Array = g.get("verts", [])
		var norms: Array = g.get("normals", [])
		var uvs: Array = g.get("uvs", [])
		var idx: Array = g.get("indices", [])
		if verts.is_empty() or idx.is_empty():
			continue
		var sv: PackedVector3Array = PackedVector3Array()
		var sn: PackedVector3Array = PackedVector3Array()
		var su: PackedVector2Array = PackedVector2Array()
		for i in verts.size():
			var v: Array = verts[i]
			sv.push_back(Vector3(float(v[0]), float(v[1]), float(v[2])))
		for i in norms.size():
			var n: Array = norms[i]
			sn.push_back(Vector3(float(n[0]), float(n[1]), float(n[2])))
		for i in uvs.size():
			var u: Array = uvs[i]
			su.push_back(Vector2(float(u[0]), float(u[1])))
		var si: PackedInt32Array = PackedInt32Array()
		for i in idx.size():
			si.push_back(int(idx[i]))
		var arrays: Array = []
		arrays.resize(Mesh.ARRAY_MAX)
		arrays[Mesh.ARRAY_VERTEX] = sv
		arrays[Mesh.ARRAY_NORMAL] = sn
		arrays[Mesh.ARRAY_TEX_UV] = su
		arrays[Mesh.ARRAY_INDEX] = si
		mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
		mesh.surface_set_name(mesh.get_surface_count() - 1, str(gname))
	return mesh


## Applies a material table {group_name: StandardMaterial3D} to a MeshInstance by surface name.
static func apply_materials(mi: MeshInstance3D, mats: Dictionary) -> void:
	var m: ArrayMesh = mi.mesh as ArrayMesh
	if m == null:
		return
	for i in m.get_surface_count():
		var sname: String = m.surface_get_name(i)
		if mats.has(sname):
			m.surface_set_material(i, mats[sname])
